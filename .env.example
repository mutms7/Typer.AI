# Only the SERVER gets this secret. Never put it in the extension.
# Use gemini for its free tier. Users don't need their own key.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative: set AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
# Reserve a conservative per-request allowance BEFORE each provider call.
# This is a request allowance, not an exact dollar estimate.
DAILY_REQUEST_BUDGET=200
MONTHLY_REQUEST_BUDGET=3000
PER_IP_HOURLY_LIMIT=20
MAX_CONCURRENT_REQUESTS=3
# Set only behind a trusted reverse proxy that overwrites this header.
TRUST_PROXY=false
IP_HASH_SECRET=replace-with-a-long-random-secret
# Exact public demo origin and extension origins, comma separated.
ALLOWED_ORIGINS=http://127.0.0.1:8787
