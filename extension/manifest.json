{
  "manifest_version": 3,
  "name": "Typer.AI",
  "version": "0.1.4",
  "icons": {
    "16": "logo-16.png",
    "32": "logo-32.png",
    "48": "logo-48.png",
    "128": "logo-128.png"
  },
  "description": "Your words, less typing. Document-grounded gray autocomplete with Tab to accept.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "logo-16.png",
      "32": "logo-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Typer.AI settings"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "engine.js",
        "editor.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
